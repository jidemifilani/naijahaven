# Copy this file to .env and fill in real values. .env is git-ignored.

DB_HOST=localhost
DB_NAME=naijahaven
DB_USER=root
DB_PASS=

# Base URL used to build absolute links in emails (verification, password reset)
APP_URL=http://127.0.0.1:8000

# Paystack (https://dashboard.paystack.com/#/settings/developer) — leave blank to
# keep the built-in demo/instant-confirm checkout in checkout.php
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
