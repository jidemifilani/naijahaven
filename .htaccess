# Apache hardening for production deployment (XAMPP/LAMP).
# Note: PHP's built-in dev server (php -S) does not read this file.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # Allow Google Fonts + inline styles/scripts this app already relies on; tighten further if you drop them.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; frame-ancestors 'self'"
</IfModule>

# Never serve secrets or internal data files directly.
<FilesMatch "^(\.env|.*\.sql|.*\.log)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag display_errors Off
</IfModule>
